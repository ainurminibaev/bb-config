#!/bin/bash
# Shared chrome-devtools-mcp (bb-config: services/chrome-devtools-shared).
# ONE autoConnect connection to the user's main Chrome profile, served to every
# local agent over MCP Streamable HTTP. Chrome 144+ asks "Allow remote
# debugging?" per new DevTools connection, so a single long-lived connection
# means one "Allow" per Chrome launch (or per restart of this service).
# Generated by scripts/chrome_devtools_shared.py --apply; do not edit in place.
export PATH="@NODE_BIN_DIR@:/usr/bin:/bin:/usr/sbin:/sbin"
exec "@MCP_PROXY@" --host 127.0.0.1 --port @PORT@ --pass-environment -- \
  "@INSTALL_DIR@/node_modules/.bin/chrome-devtools-mcp" \
  --autoConnect --no-usage-statistics --no-performance-crux --allow-unrestricted-paths
