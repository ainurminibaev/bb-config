{
  "schemaVersion": 1,
  "description": "Declared set of bb-config: every component one install or update converges to. Order matters: dependencies first.",
  "machineActions": [
    {
      "id": "codex-defaults",
      "text": "На каждой машине, где работает Codex: python3 scripts/codex_defaults.py --apply --verify из checkout bb-config (под пользователем запуска CLI)."
    }
  ],
  "components": [
    {"id": "config-updates", "kind": "local", "name": "Config Updates",
     "attention": [{"type": "setting", "text": "Checkout bb-config должен быть проектом BB на машине сервера; установка создаёт проект, если его нет."}]},
    {"id": "voice-mode-keeper", "kind": "local", "name": "Plugin Keeper"},
    {"id": "codex-realtime", "kind": "catalog", "name": "ChatGPT Realtime Connection",
     "source": "git:https://github.com/gpambrozio/bb-plugins.git@", "install": "codex-realtime@bb-community", "min": "0.1.0",
     "attention": [{"type": "auth", "text": "Нужен личный вход Codex через ChatGPT на машине сервера BB (codex login). Токены в bb-config не хранятся."}]},
    {"id": "voice-mode", "kind": "git", "name": "Voice Mode (форк)",
     "source": "git:https://github.com/ainurminibaev/bb-plugin-voice-mode.git@", "install": "git:https://github.com/ainurminibaev/bb-plugin-voice-mode.git@^0.2.0",
     "min": "0.2.8", "requires": ["codex-realtime"],
     "adopt": {"check": ["{python}", "plugins/voice-mode/switch_to_fork.py", "--check"],
               "apply": ["{python}", "plugins/voice-mode/switch_to_fork.py", "--apply"]},
     "configure": [{"name": "мост Codex Live", "check": ["{python}", "scripts/voice_mode_bridge.py", "--check"],
                    "apply": ["{python}", "scripts/voice_mode_bridge.py", "--apply"]}],
     "attention": [{"type": "auth", "text": "Голос идёт через подписку ChatGPT пользователя (вход Codex на сервере); микрофон разрешается в клиенте при первом звонке."}]},
    {"id": "handoff", "kind": "catalog", "name": "Handoff",
     "source": "git:https://github.com/vburojevic/bb-plugin-handoff.git@", "install": "handoff@bb-community", "min": "0.7.0"},
    {"id": "handoff-button", "kind": "local", "name": "Handoff Button", "requires": ["handoff"]},
    {"id": "inbox", "kind": "catalog", "name": "Needs You",
     "source": "git:https://github.com/notpritam/bb-plugin-inbox.git@", "install": "inbox@bb-community", "min": "0.2.0"},
    {"id": "tokenomics", "kind": "catalog", "name": "Tokenomics",
     "source": "git:https://github.com/danielbachhuber/bb-plugins.git@", "install": "tokenomics@bb-community", "min": "0.2.0"},
    {"id": "kodaforge", "kind": "catalog", "name": "KodaForge",
     "source": "git:https://github.com/Kodaks94/bb-plugin-kodaforge.git@", "install": "kodaforge@bb-community", "min": "0.7.0",
     "configure": [{"name": "вкладки рабочих областей (Keeper)", "check": ["{python}", "scripts/kodaforge_workspace_tabs.py", "--check"],
                    "apply": ["{python}", "scripts/kodaforge_workspace_tabs.py", "--apply"]}]},
    {"id": "kodaforge-inspector", "kind": "local", "name": "KodaForge Inspector", "requires": ["kodaforge"]},
    {"id": "code-open", "kind": "local", "name": "Code Open", "requires": ["kodaforge"]},
    {"id": "codex-project-trust", "kind": "git", "name": "Codex Project Trust",
     "source": "git:https://github.com/ainurminibaev/bb-codex-project-trust.git@", "install": "git:https://github.com/ainurminibaev/bb-codex-project-trust.git@^1.0.0",
     "min": "1.0.0"},
    {"id": "machine-tabs", "kind": "local", "name": "Machine Tabs"},
    {"id": "project-logo", "kind": "local", "name": "Project Logo", "requires": ["machine-tabs"]},
    {"id": "project-catalog", "kind": "local", "name": "Project Catalog", "requires": ["machine-tabs"]},
    {"id": "project-machine-setup", "kind": "local", "name": "Project Machine Setup"},
    {"id": "subthread-autocollapse", "kind": "local", "name": "Subthread Autocollapse"},
    {"id": "thread-account-usage", "kind": "local", "name": "Thread Account Usage"},
    {"id": "menubar-status", "kind": "local", "name": "Menubar Status",
     "attention": [{"type": "machine", "text": "На Mac: zsh install.sh из plugins/menubar-status/macos (нужен xcode-select --install); на Windows: install.ps1 из plugins/menubar-status/windows. Задайте hostId и filePath в настройках плагина."}]},
    {"id": "project-open", "kind": "local", "name": "Project Open",
     "attention": [{"type": "machine", "text": "Для кнопки Finder нужен локальный обработчик на Mac (plugins/project-open/README.md)."}]},
    {"id": "file-local-open", "kind": "local", "name": "Open on Desktop",
     "attention": [{"type": "setting", "text": "При нескольких настольных компьютерах задайте macHostId в настройках плагина."}]},
    {"id": "browser-page", "kind": "local", "name": "Browser Page"},
    {"id": "proxy-manager", "kind": "local", "name": "Proxy Manager",
     "attention": [{"type": "setting", "text": "Прокси и маршруты добавляются вручную; установка их не меняет."}]},
    {"id": "push-button", "kind": "local", "name": "Push Button"},
    {"id": "web-bb-button", "kind": "local", "name": "Web BB Button",
     "attention": [{"type": "setting", "text": "Задайте «Публичный адрес BB» (webUrl) в настройках плагина."}]},
    {"id": "local-transcribe", "kind": "local", "name": "Local Transcribe",
     "attention": [{"type": "machine", "text": "Исполнители распознавания: задайте workerHosts; на них нужны Python и ffmpeg (окружение готовится при первом обращении)."}]}
  ]
}
