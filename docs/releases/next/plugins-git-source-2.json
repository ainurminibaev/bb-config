{
  "id": "plugins-git-source-2",
  "title": "Ещё 13 плагинов bb-config получают обновления штатно от BB (Git-источник), в том числе с расписаниями, данными и секретами",
  "component": "plugins-git-source-2",
  "where": "server",
  "kind": "command",
  "after": [
    "plugins-git-source"
  ],
  "applies": [
    "{python}",
    "scripts/plugin_git_source.py",
    "--applicable",
    "project-logo",
    "kodaforge-inspector",
    "codex-delegation-watch",
    "context-mode-rollout",
    "menubar-status",
    "file-local-open",
    "voice-mode-keeper",
    "machine-tabs",
    "pr-issues",
    "browser-page",
    "limit-guard",
    "project-catalog",
    "proxy-manager"
  ],
  "apply": [
    "{python}",
    "scripts/plugin_git_source.py",
    "--apply",
    "--allow-remove",
    "project-logo",
    "kodaforge-inspector",
    "codex-delegation-watch",
    "context-mode-rollout",
    "menubar-status",
    "file-local-open",
    "voice-mode-keeper",
    "machine-tabs",
    "pr-issues",
    "browser-page",
    "limit-guard",
    "project-catalog",
    "proxy-manager"
  ],
  "verify": [
    "{python}",
    "scripts/plugin_git_source.py",
    "--check",
    "project-logo",
    "kodaforge-inspector",
    "codex-delegation-watch",
    "context-mode-rollout",
    "menubar-status",
    "file-local-open",
    "voice-mode-keeper",
    "machine-tabs",
    "pr-issues",
    "browser-page",
    "limit-guard",
    "project-catalog",
    "proxy-manager"
  ],
  "rerun": "Плагины переводятся по одному; прерванный перевод продолжается по приватному журналу и сохранённой копии секретов. Уже переведённые с совпавшими настройками не переустанавливаются. Плагины не из папки выпуска или checkout bb-config и отсутствующие не трогаются.",
  "rollback": "python3 scripts/plugin_git_source.py --rollback --allow-remove <id> — возвращает плагин на прежнюю папку с прежними настройками и секретами."
}
