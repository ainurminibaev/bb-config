{
  "id": "plugins-git-source",
  "title": "12 плагинов bb-config получают обновления штатно от BB (Git-источник)",
  "component": "plugins-git-source",
  "where": "server",
  "kind": "command",
  "after": [],
  "applies": [
    "{python}",
    "scripts/plugin_git_source.py",
    "--applicable",
    "subthread-autocollapse",
    "web-bb-button",
    "handoff-button",
    "project-machine-setup",
    "shared-guides",
    "git-thread-provenance",
    "codex-goal-queue",
    "fresh-thread-hint",
    "project-open",
    "code-open",
    "thread-account-usage",
    "push-button"
  ],
  "apply": [
    "{python}",
    "scripts/plugin_git_source.py",
    "--apply",
    "--allow-remove",
    "subthread-autocollapse",
    "web-bb-button",
    "handoff-button",
    "project-machine-setup",
    "shared-guides",
    "git-thread-provenance",
    "codex-goal-queue",
    "fresh-thread-hint",
    "project-open",
    "code-open",
    "thread-account-usage",
    "push-button"
  ],
  "verify": [
