    "scripts/plugin_git_source.py",
    "--check",
    "subthread-autocollapse",
    "web-bb-button",
    "handoff-button",
    "project-machine-setup",
    "shared-guides",
    "git-thread-provenance",
    "codex-goal-queue",
    "fresh-thread-hint",
    "project-open",
    "code-open",
    "thread-account-usage",
    "push-button"
  ],
  "rerun": "Плагины переводятся по одному; прерванный перевод продолжается по приватному журналу. Уже переведённые с совпавшими настройками не переустанавливаются. Плагины не из папки выпуска bb-config и отсутствующие не трогаются.",
  "rollback": "python3 scripts/plugin_git_source.py --rollback --allow-remove <id> — возвращает плагин из сохранённой папки прежнего выпуска с прежними настройками."
}
